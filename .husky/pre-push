#!/bin/sh
# husky.sh re-runs this hook, so it must come before stdin is read.
. "$(dirname "$0")/_/husky.sh"

command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
# Git sends the pushed refs once on stdin, and both git lfs and the secrets scan need them.
refs=$(cat)
printf '%s\n' "$refs" | git lfs pre-push "$@" || exit 1

if command -v gitleaks >/dev/null 2>&1; then
  zero=0000000000000000000000000000000000000000
  printf '%s\n' "$refs" | while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] || [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
      range="$local_sha --not --remotes"
    else
      range="$remote_sha..$local_sha"
    fi
    gitleaks git --no-banner --redact --log-opts="$range" . || exit 1
  done || exit 1
else
  echo "gitleaks not installed, skipping secrets scan (brew install gitleaks)"
fi

yarn lint:ts

if ! git rev-parse --verify -q origin/main >/dev/null; then
  echo "origin/main not found, skipping nearby tests (CI runs the full suite)"
  exit 0
fi

# Only the tests beside changed files: related-test discovery fans out to thousands here, and CI runs the full suite.
tests=$(git diff --name-only --diff-filter=AMR origin/main...HEAD -- '*.ts' '*.tsx' | while read -r file; do
  case "$file" in
    (*.test.ts | *.test.tsx) echo "$file" ;;
    (*)
      base="${file%.*}"
      for test in "$base.test.ts" "$base.test.tsx"; do
        [ -f "$test" ] && echo "$test"
      done
      ;;
  esac
done | sort -u)

if [ -n "$tests" ]; then
  # runTestsByPath takes paths as-is, so Next.js [param] folders are not read as regex.
  echo "$tests" | tr '\n' '\0' | xargs -0 yarn test --runTestsByPath
fi
